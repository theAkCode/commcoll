.show-post{
    background: #1E1E1E;
    border-radius: 20px;
    box-shadow:  8px 8px 15px #0FA4AF;
    margin-bottom: 50px;
    border: 1px solid #5f5f5f;
}


.posts h3{
    font-size: 19px;
    margin-bottom: 15px;
    color: #fff;
}
.posts p{
    font-size: 19px;
    margin-bottom: 15px;
    color: #fff;
}

.posts{
    padding: 20px;
    margin-top: 15px;
    
}
.show-link{
   display: flex;
   align-items: center;
   justify-content: space-between;
    
    
    
}
